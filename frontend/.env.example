# --- API base URL (optional; the Vite dev proxy already forwards /api) ---
VITE_API_URL=http://localhost:5000/api

# --- Google sign-in (OPTIONAL) ---
# Same Web OAuth Client ID as backend/.env GOOGLE_CLIENT_ID
# (see README → "Google sign-in"). Leave empty and the
# "Continue with Google" button is hidden on the Auth page.
VITE_GOOGLE_CLIENT_ID=

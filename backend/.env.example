# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (never point this at craftveda for experiments) ---
MONGO_URI=mongodb://localhost:27017/craftveda

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- CORS: allowed frontend origin(s), comma-separated ---
CLIENT_URL=http://localhost:3000

# --- Razorpay (OPTIONAL, test mode) ---
# Leave empty to use Cash on Delivery, which works without Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Cloudinary (OPTIONAL, image hosting) ---
# Leave all three empty and image uploads return 503 "Image upload is not
# configured" (the rest of the app keeps working). Never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google sign-in (OPTIONAL) ---
# Web OAuth Client ID from Google Cloud Console (see README → "Google sign-in").
# Leave empty: the "Continue with Google" button is hidden and
# POST /api/auth/google returns 503 "Google sign-in is not configured".
GOOGLE_CLIENT_ID=

# --- Email OTP for forgot-password (Gmail SMTP) ---
# Leave empty in development: the code is printed to the server console so the
# flow still works locally. In production, missing SMTP returns 503.
# For Gmail use an App Password (README → "Forgot-password emails"), never your
# real account password. Never commit real values.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Optional overrides for `npm run seed-admin` (defaults shown) ---
ADMIN_EMAIL=admin@craftveda.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Admin

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (never point this at craftveda for experiments) ---
MONGO_URI=mongodb://localhost:27017/craftveda

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- CORS: allowed frontend origin(s), comma-separated ---
CLIENT_URL=http://localhost:3000

# --- Razorpay (OPTIONAL, test mode) ---
# Leave empty to use Cash on Delivery, which works without Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Cloudinary (OPTIONAL, image hosting) ---
# Leave all three empty and image uploads return 503 "Image upload is not
# configured" (the rest of the app keeps working). Never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional overrides for `npm run seed-admin` (defaults shown) ---
ADMIN_EMAIL=admin@craftveda.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Admin
